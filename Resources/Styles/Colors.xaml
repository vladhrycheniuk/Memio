<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    
    <Color x:Key="PrimaryColor">#FFD6A5</Color>
    <Color x:Key="SecondaryColor">#FDFFB6</Color>
    <Color x:Key="BackgroundColor">#F9F9F9</Color>
    
    <!-- Ці ключі критично важливі для меню -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="TextPrimary">#4A4A4A</Color>
    <Color x:Key="TextSecondary">#9A9A9A</Color>
    <Color x:Key="ColumnBg">#F0F0F0</Color>
    
    <Shadow x:Key="CardShadow" Brush="Black" Opacity="0.1" Radius="15" Offset="5,5" />
</ResourceDictionary>