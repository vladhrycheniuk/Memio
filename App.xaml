<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Memio"
             x:Class="Memio.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ЖОРСТКИЙ ЗАПУСК: Визначаємо кольори тут, щоб не залежати від файлів -->
            <Color x:Key="PrimaryColor">#E69A8D</Color>
            <Color x:Key="SecondaryColor">#DAC4B6</Color>
            <Color x:Key="BgColor">#FDFBF7</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#4A403A</Color>
            <Color x:Key="TextSecondary">#9C9086</Color>

            <!-- Стиль сторінки -->
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource BgColor}" />
            </Style>

            <!-- Стиль тексту -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>
            
            <!-- Стиль карток -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="15" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>