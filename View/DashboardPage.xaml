<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Memio.ViewModel"
             x:Class="Memio.View.DashboardPage"
             Title="Dashboard"
             BackgroundColor="{StaticResource BgColor}">
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">
            <Label Text="Hello, User!" FontSize="32" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
            <Label Text="Here is your daily overview" FontSize="16" TextColor="{StaticResource TextSecondary}"/>

            <!-- Статистика -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Border Style="{StaticResource CardStyle}" BackgroundColor="{StaticResource PrimaryColor}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{Binding PendingTasks}" FontSize="36" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Pending Tasks" TextColor="White"/>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{Binding DoneTasks}" FontSize="36" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}"/>
                        <Label Text="Completed" TextColor="{StaticResource TextSecondary}"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Сьогоднішні задачі -->
            <Label Text="Today's Tasks" FontSize="20" FontAttributes="Bold" Margin="0,10,0,0"/>
            
            <CollectionView ItemsSource="{Binding TodaysTasks}" HeightRequest="300">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding Title}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="TODAY" FontSize="10" TextColor="Red" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No tasks for today. Relax!" HorizontalOptions="Center" Margin="20"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>