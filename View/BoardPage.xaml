<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Memio.ViewModel"
             xmlns:model="clr-namespace:Memio.Model"
             x:Class="Memio.View.BoardPage"
             Title="My Board"
             BackgroundColor="{Binding BoardBackground}">

    <Grid RowDefinitions="Auto, *" Padding="20,10,0,0">
        <!-- Тільки назва дошки -->
        <VerticalStackLayout Margin="0,10,20,15">
            <Label Text="{Binding CurrentBoardName}" FontSize="26" FontAttributes="Bold" TextColor="#4A403A"/>
            <Label Text="Memio Beta 1.1" FontSize="12" TextColor="#9C9086"/>
        </VerticalStackLayout>

        <!-- Скрол (без змін) -->
        <ScrollView Grid.Row="1" Orientation="Horizontal">
            <StackLayout BindableLayout.ItemsSource="{Binding Columns}" Orientation="Horizontal" Spacing="20" Padding="0,0,20,20">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="model:ColumnModel">
                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#F4EFEA" WidthRequest="300" Padding="12" StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <DropGestureRecognizer AllowDrop="True" DropCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:BoardViewModel}}, Path=DragOverCommand}" DropCommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto, *">
                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#4A403A" VerticalOptions="Center"/>
                                    <Button Grid.Column="1" Text="+" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BoardViewModel}}, Path=AddTaskCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="#4A403A" FontSize="24"/>
                                </Grid>
                                <ScrollView Grid.Row="1">
                                    <StackLayout BindableLayout.ItemsSource="{Binding Tasks}" Spacing="10" Padding="2">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="model:TaskItem">
                                                <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="0">
                                                    <Border.Shadow><Shadow Brush="#000000" Opacity="0.05" Radius="5" Offset="0,2"/></Border.Shadow>
                                                    <Border.GestureRecognizers>
                                                        <DragGestureRecognizer CanDrag="True" DragStartingCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:BoardViewModel}}, Path=DragStartedCommand}" DragStartingCommandParameter="{Binding .}"/>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BoardViewModel}}, Path=OpenTaskDetailsCommand}" CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <Grid RowDefinitions="Auto, Auto, Auto" Padding="12">
                                                        <BoxView Color="{Binding TagColor}" HeightRequest="4" WidthRequest="50" HorizontalOptions="Start" CornerRadius="2" Margin="0,0,0,8"/>
                                                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                                                            <VerticalStackLayout Spacing="4">
                                                                <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="#333"/>
                                                                <Label Text="{Binding Description}" FontSize="12" TextColor="#888" LineBreakMode="TailTruncation"/>
                                                            </VerticalStackLayout>
                                                            <Button Grid.Column="1" Text="✕" TextColor="#999" BackgroundColor="Transparent" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BoardViewModel}}, Path=DeleteTaskCommand}" CommandParameter="{Binding .}" WidthRequest="30"/>
                                                        </Grid>
                                                        <Label Grid.Row="2" Text="{Binding DueDate, StringFormat='{0:MMM dd}'}" FontSize="10" TextColor="#AAA" HorizontalOptions="Start" Margin="0,8,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>
                                </ScrollView>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>